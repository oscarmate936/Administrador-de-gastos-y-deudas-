<?xml version="1.0" encoding="utf-8"?>
<!-- Widget: etiqueta, cifra grande, detalle y botón «+ Gasto». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_etiqueta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_etiqueta"
            android:textColor="#D9F1E9"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_gasto"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/widget_boton"
            android:contentDescription="@string/widget_gasto_descripcion"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/widget_gasto"
            android:textColor="#0F6B54"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_monto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="—"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_detalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_detalle_inicial"
        android:textColor="#D9F1E9"
        android:textSize="12sp" />
</LinearLayout>
